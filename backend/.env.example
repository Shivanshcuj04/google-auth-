# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
# Option A (zero setup): set USE_MEMORY_DB=true and leave MONGO_URI as-is/blank.
#   This auto-starts a real MongoDB instance for you, no install or account needed.
# Option B: set USE_MEMORY_DB=false and provide a real MONGO_URI
#   (local mongod, or a MongoDB Atlas connection string).
USE_MEMORY_DB=true
MONGO_URI=mongodb://localhost:27017/google-oauth-app

# Session
SESSION_SECRET=change_this_to_a_long_random_string

# Google OAuth (get these from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
